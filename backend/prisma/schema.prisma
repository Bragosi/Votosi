generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id String @id @default(cuid())

  // Personal Info
  firstName String
  surname  String
  otherName String?
  email     String @unique
  profilePicture String
  DOB String
  sex Sex
  maritalStatus MaritalStatus
  state String
  LGA String
  education EducationLevel
  residentialAddress String

  // Login
  password String?

  // Generated Credentials
  adminId       String @unique
  activationPin String

  // Account Status
  isActivated Boolean @default(false)

  // Role
  role AdminRole @default(OFFICER)

  // Audit
  createdById String?
  createdBy   Admin?  @relation("AdminCreator", fields: [createdById], references: [id])

  createdAdmins Admin[] @relation("AdminCreator")

  // Voters created by this officer/admin
  votersCreated Voter[] @relation("OfficerCreatedVoters")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voter {
  id String @id @default(cuid())

  // Personal Info
  firstName      String
  surname       String
  otherName      String?
  email          String  @unique
  profilePicture String
  DOB String
  sex Sex
  maritalStatus MaritalStatus
  state String
  LGA String
  education EducationLevel
  residentialAddress String
  // Login
  password String?

  // Generated Credentials
  voterId       String @unique
  activationPin String

  // Account Status
  isActivated Boolean @default(false)

  votes Vote[]


  // Audit
  createdById String?
  createdBy   Admin? @relation("OfficerCreatedVoters", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Election {
  id          String   @id @default(cuid())
  title       String @unique
  description String?
  status      ElectionStatus @default(DRAFT)

  startDate   DateTime
  endDate     DateTime

  candidates  Candidate[]
  votes       Vote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Candidate {
  id          String   @id @default(cuid())
  
  // Personal Info
  firstName      String
  surname       String
  otherName      String?
  DOB String
  sex Sex
  maritalStatus MaritalStatus
  state String
  LGA String
  education EducationLevel
  bio         String
  imageUrl    String
  party       PoliticalParty

  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  votes       Vote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Vote {
  id          String   @id @default(cuid())

  voterId     String
  electionId  String
  candidateId String

  voter       Voter     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([voterId, electionId])
}

enum PoliticalParty {
  APC
  PDP
  LP
  NNPP
  APGA
  SDP
  YPP
}

enum ElectionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AdminRole {
  OFFICER
  ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EducationLevel {
  PRIMARY
  SECONDARY
  TERTIARY
}